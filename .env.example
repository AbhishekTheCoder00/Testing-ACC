# Copy this file to .env and fill in real values
# NEVER commit .env to git

# Flask session signing key — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=<your-random-32-char-hex-string>

# ============================================================================
# ACC (Autodesk Platform Services) app credentials — GLOBAL, from .env.
# These apply to every user of the deployment. Register at: https://aps.autodesk.com/myapps/
#
# TWO apps are required. Autodesk gates each flow on the app's registered type,
# so one Client ID cannot serve both:
#   - 3LO sign-in needs a callback URL      -> "Web App" type
#   - POST /service-accounts (robots)       -> "Server-to-Server" type
# ============================================================================

# Sign-in app — "Web App", callback URL must match APS_REDIRECT_URI.
APS_CLIENT_ID=<your-aps-web-app-client-id>
APS_CLIENT_SECRET=<your-aps-web-app-client-secret>
APS_REDIRECT_URI=http://localhost:8000/callback

# Robot app — "Server-to-Server", with the four application:service_account* scopes
# enabled (FR-03 6.1). Seeds the aps_apps registry as shard app_a on first start.
# Falls back to APS_CLIENT_ID / APS_CLIENT_SECRET when unset, for deployments that
# predate the split.
APS_SSA_CLIENT_ID=<your-aps-server-to-server-client-id>
APS_SSA_CLIENT_SECRET=<your-aps-server-to-server-client-secret>

# Optional — link shown in Connect ACC when no hubs are found (beta / release docs).
# CONNECTOR_DOCS_URL=https://example.com/acc-connector-docs

# Optional — link shown in Connect ACC when no hubs are found (beta / release docs).
# CONNECTOR_DOCS_URL=https://example.com/acc-connector-docs

# Optional — defaults to true. Set false for an M2M-only deployment: / serves the
# multi-tenant portal, every wizard-only route 404s and the U2M daily CDC timers stay
# down. The portal's own routes (including the ACC/Databricks OAuth and picker routes it
# borrows) keep working.
# ENABLE_U2M=false

# ============================================================================
# Databricks OAuth — the authorize callback URL is GLOBAL (from .env).
# The OAuth app Client ID / Client Secret / Workspace URL are PER-USER: each
# ACC user enters them in the "Connect Databricks" panel and they are stored in
# the app_secrets table keyed by the ACC user_id, read at runtime with env
# vars taking precedence.
# ============================================================================
# Create an OAuth app per user in Databricks: Settings → Developer → OAuth Applications
# Set the redirect URI to the value of DATABRICKS_REDIRECT_URI below.
# Databricks OIDC OAuth (works on both Azure and AWS Databricks)
# Create an OAuth app in your Databricks workspace: Settings → Developer → OAuth Applications
# Set the redirect URI to the value of DATABRICKS_REDIRECT_URI below
DATABRICKS_CLIENT_ID=<your-databricks-oauth-app-client-id>
DATABRICKS_CLIENT_SECRET=<your-databricks-oauth-app-client-secret>
DATABRICKS_REDIRECT_URI=http://localhost:8000/databricks/callback

# Request the `offline_access` scope so the OAuth server issues a refresh token,
# allowing silent token refresh without a re-login. Required for both the
# user-provided OAuth flow and the M2M service-principal flow.
DATABRICKS_OAUTH_SCOPE=all-apis offline_access

# Optional — scope override (default: all-apis offline_access)
# DATABRICKS_OAUTH_SCOPE=all-apis offline_access

# Optional — override OIDC endpoints (auto-discovered from workspace if not set)
# DATABRICKS_OAUTH_AUTHORIZE_URL=https://<workspace>/oidc/v1/authorize
# DATABRICKS_OAUTH_TOKEN_URL=https://<workspace>/oidc/v1/token

# ============================================================================
# Database backend (optional)
# ============================================================================
# Leave unset for local SQLite (backend/connector.db, zero config).
# To use PostgreSQL, provide a libpq key=value DSN; the database is created
# automatically on startup if it does not exist yet.
# Example:
# CONN_STRING=host=localhost port=5432 dbname=acc_connector user=postgres password=CHANGE_ME connect_timeout=10 sslmode=prefer

# Feature flag — delegates the per-table Data Connector CSV downloads to the
# bulk_downloader Job running in the customer's Databricks workspace instead
# of pulling them through the Flask process. Flask still pulls the small
# autodesk_data_extract.zip directly (it's needed in memory to seed the PK
# registry). Requires bootstrap to have been run after Step 9b was introduced
# so bootstrap_state.download_job_id is populated.
# Default: false. Flip to true once the new path has been validated in your
# environment; the legacy in-Flask helper will be deleted in a later release.
# ENABLE_NOTEBOOK_DOWNLOAD=true

# Feature flag — Zerobus prerequisite diagnostics only (not a sync path).
# When false (default): no /sync/zerobus-status route, no zerobus_eligible on
# the catalog list, zerobus_status is never imported. Flip to true to debug
# catalog storage + SP grants before wiring a Zerobus writer (future work).
# ENABLE_ZEROBUS=true

# Optional — seconds to wait for ACC Data Connector to queue a job after create_request (default 1800)
# DC_JOB_APPEAR_WAIT=1800

# Optional — minutes to wait for the combined sync workflow (bulk_download + pipelines).
# First full snapshot often needs 60–120+ minutes on serverless; default 120.
# SYNC_WORKFLOW_MAX_WAIT_MIN=120

# Optional — when true, only exports assets + cdcsheets for faster dev/pilot runs.
# Unset or false for production full export (code default is false).
# SYNC_TEST_SUBSET=true

# ============================================================================
# Multi-tenant M2M (Phase 1) — hub-scoped SSA + per-connection Databricks SP.
# Per-hub and per-connection credentials live in the SecretStore, NOT here.
# The legacy global ACC_SSA_* / ACC_M2M_* / DATABRICKS_M2M_* vars are gone.
# ============================================================================
# SECRET_STORE_BACKEND=local          # local | memory | aws
# SECRET_STORE_PREFIX=forma-connector
# APP_ENV=dev                         # dev | staging | prod
# SECRET_STORE_DIR=./secrets/store    # local backend only
# AWS_REGION=us-east-1                # aws backend only

# Hub-admin enforcement. Whitelisting the connector Client ID in ACC Custom
# Integrations is a documented prerequisite completed BEFORE first sign-in, so the
# account-admin probe is answerable by the time anyone reaches us and strict is safe.
#   strict (default) — a user we cannot confirm as hub admin is denied, with a distinct
#                      "finish the Custom Integration step" message, not "not an admin".
#   provisional      — also admit hubs we cannot yet probe, so an admin who skipped the
#                      documented step can still reach the whitelist screen. Robot
#                      provisioning stays blocked until the probe turns conclusive.
#   permissive       — local dev only; every visible hub is treated as administered.
# HUB_ADMIN_ENFORCEMENT=strict

# Shared bootstrap/sync step library kill switch. false = pre-refactor U2M
# code path. Flip to true after staging soak, then the old path is deleted.
# USE_SHARED_STEPS=false

# Shared secret required by POST /internal/scheduler/cdc (cron hook). Scheduled CDC is driven
# by OS cron / EventBridge hitting that endpoint; there is deliberately no in-process ticker,
# because every gunicorn worker would run its own and double-sync each connection.
# The endpoint fails closed (503) while this is unset, so scheduled sync is off by default.
# INTERNAL_SCHEDULER_TOKEN=<random-hex>

# ============================================================================
# The multi-tenant M2M portal is served at /portal — a separate page from the
# single-user wizard at /, which is unchanged. Nothing on / links to it yet
# (moving the portal to / and retiring the old page is the next phase).
# ============================================================================
