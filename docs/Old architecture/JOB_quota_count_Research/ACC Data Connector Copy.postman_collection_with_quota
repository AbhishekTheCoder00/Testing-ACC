    {
      "name": "accounts/{accountId}/jobs",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "// Parse the response JSON\r",
              "const apiResponse = pm.response.json();\r",
              "\r",
              "// Current time\r",
              "const now = new Date();\r",
              "\r",
              "// Rolling 24-hour window\r",
              "const twentyFourHoursAgo = new Date(now.getTime() - (24 * 60 * 60 * 1000));\r",
              "\r",
              "// Filter jobs created within the last 24 hours\r",
              "const jobsInLast24Hours = apiResponse.results.filter(job => {\r",
              "    const createdAt = new Date(job.createdAt);\r",
              "    return createdAt >= twentyFourHoursAgo;\r",
              "});\r",
              "\r",
              "// Count jobs\r",
              "const activeHubJobCount = jobsInLast24Hours.length;\r",
              "\r",
              "// Remaining quota\r",
              "const remainingJobsAllowed = Math.max(0, 24 - activeHubJobCount);\r",
              "\r",
              "// Print results\r",
              "console.log(\"Jobs in last 24 hours:\", activeHubJobCount);\r",
              "console.log(\"Remaining jobs:\", remainingJobsAllowed);"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "https://developer.api.autodesk.com/data-connector/v1/accounts/:accountId/jobs?limit=100",
          "protocol": "https",
          "host": [
            "developer",
            "api",
            "autodesk",
            "com"
          ],
          "path": [
            "data-connector",
            "v1",
            "accounts",
            ":accountId",
            "jobs"
          ],
          "query": [
            {
              "key": "limit",
              "value": "100"
            }
          ],
          "variable": [
            {
              "key": "accountId",
              "value": "a50dcb76-5328-4d9e-9898-3795ad0d1015"
            }
          ]
        }
      },
      "response": []
