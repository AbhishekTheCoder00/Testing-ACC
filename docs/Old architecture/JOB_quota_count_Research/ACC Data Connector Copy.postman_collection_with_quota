    {
      "name": "accounts/{accountId}/jobs Copy",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const response = pm.response.json();\r",
              " \r",
              "// ============================================================\r",
              "// ADD YOUR USER EMAIL IDs HERE\r",
              "// ============================================================\r",
              "const userFilter = [\r",
              "    \"gajendra.tandekar@cctech.co.in\",\r",
              "    \"abhishek.suryawanshi@autodesk.com\"\r",
              "];\r",
              "// ============================================================\r",
              " \r",
              "const now = new Date();\r",
              "const cutoff = new Date(now.getTime() - 24 * 60 * 60 * 1000);\r",
              " \r",
              "function toIST(date) {\r",
              "    return date.toLocaleString(\"en-IN\", {\r",
              "        timeZone: \"Asia/Kolkata\",\r",
              "        year: \"numeric\",\r",
              "        month: \"2-digit\",\r",
              "        day: \"2-digit\",\r",
              "        hour: \"2-digit\",\r",
              "        minute: \"2-digit\",\r",
              "        second: \"2-digit\",\r",
              "        hour12: false\r",
              "    });\r",
              "}\r",
              " \r",
              "console.log(\"Current IST :\", toIST(now));\r",
              "console.log(\"Cutoff IST  :\", toIST(cutoff));\r",
              "console.log(\"================================\");\r",
              " \r",
              "// Initialize map for all users in the filter list\r",
              "const userJobMap = {};\r",
              "userFilter.forEach(email => {\r",
              "    userJobMap[email.toLowerCase()] = { count: 0, userId: \"N/A\", originalEmail: email };\r",
              "});\r",
              " \r",
              "let totalCount = 0;\r",
              " \r",
              "response.results.forEach(job => {\r",
              "    const created = new Date(job.createdAt);\r",
              "    const email = (job.createdByEmail || \"\").toLowerCase();\r",
              "    const userId = job.createdBy || \"unknown\";\r",
              " \r",
              "    if (created >= cutoff) {\r",
              "        if (userJobMap[email] !== undefined) {\r",
              "            totalCount++;\r",
              "            userJobMap[email].count++;\r",
              "            userJobMap[email].userId = userId;\r",
              "            console.log(`Included | Job ID: ${job.id} | User: ${email} | Created: ${toIST(created)}`);\r",
              "        }\r",
              "    }\r",
              "});\r",
              " \r",
              "console.log(\"================================\");\r",
              "console.log(\"--- Jobs per User (last 24 hrs) ---\");\r",
              " \r",
              "userFilter.forEach(email => {\r",
              "    const info = userJobMap[email.toLowerCase()];\r",
              "    console.log(`User: ${info.originalEmail} | User ID: ${info.userId} | Jobs: ${info.count} | Remaining Quota: ${Math.max(0, 24 - info.count)}`);\r",
              "});\r",
              " \r",
              "console.log(\"--------------------------------\");\r",
              "console.log(\"Total Users tracked:\", userFilter.length);\r",
              "console.log(\"Total Jobs in last 24 hours:\", totalCount);\r",
              "console.log(\"Current IST:\", toIST(now));\r",
              "console.log(\"Cutoff IST :\", toIST(cutoff));\r",
              " \r",
              "pm.collectionVariables.set(\"jobSummary_totalJobs\", totalCount);\r",
              "pm.collectionVariables.set(\"jobSummary_totalUsers\", userFilter.length);\r",
              "pm.collectionVariables.set(\"jobSummary_perUser\", JSON.stringify(userJobMap));"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
